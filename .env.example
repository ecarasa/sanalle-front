# === Frontend (sanalle-front) — variables para Railway ===
# Copiá estas claves en Railway → Service → Variables.

# --- Proxy al backend (RUNTIME) ---
# El front reescribe /api/* hacia acá desde el servidor de Next (no lo ve el browser).
# Poné la URL pública del servicio backend en Railway. Ejemplos:
#   BACKEND_INTERNAL_URL=https://sanalle-back-production.up.railway.app
# (Si usás la red privada de Railway, el backend debe escuchar en IPv6 [::];
#  por simplicidad se recomienda la URL pública.)
BACKEND_INTERNAL_URL=https://sanalle-back-production.up.railway.app

# --- Build-time (NEXT_PUBLIC_*): se hornean en el build ---
# Railway los pasa como build args al Dockerfile (ya declarados como ARG).
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_APP_NAME=Vitalnova
